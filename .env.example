TELEGRAM_BOT_TOKEN=put-token-from-BotFather-here
# optional: if empty, the bot learns your chat when you send /start
TELEGRAM_CHAT_ID=
TIKTOK_USERS=al3ramram21
POLL_SECONDS=60

# --- recorder.py (runs on your PC) ---
# REC_DIR=D:\TikTok-recordings
# REC_SEND=1                 # 0 = keep files local, don't upload to Telegram
# REC_SEND_MAX_MB=1024       # bigger recordings are only announced
# Age-restricted streams need a logged-in TikTok session. Copy the `sessionid`
# (and `tt-target-idc`) cookie values from your browser into your LOCAL .env only.
# Use a spare TikTok account, never share these values, and never commit them.
# TIKTOK_SESSIONID=
# TIKTOK_TT_TARGET_IDC=
